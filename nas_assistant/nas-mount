#!/bin/sh
# Mount the NAS disk read-write: nas-mount <device> <mountpoint>
set -e
DEVICE="$1"
TARGET="$2"
FSTYPE="$(blkid -p -s TYPE -o value "${DEVICE}" 2>/dev/null || true)"

case "${FSTYPE}" in
    ntfs)
        # Prefer the kernel ntfs3 driver; fall back to ntfs-3g. Never the read-only "ntfs".
        mount -t ntfs3 -o rw,noatime "${DEVICE}" "${TARGET}" 2>/dev/null \
            || ntfs-3g -o rw,noatime,big_writes "${DEVICE}" "${TARGET}"
        ;;
    *)
        mount -o rw,noatime "${DEVICE}" "${TARGET}"
        ;;
esac
